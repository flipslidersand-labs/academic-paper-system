{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["before 3am on Monday"],
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["pip_requirements", "pyproject"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
