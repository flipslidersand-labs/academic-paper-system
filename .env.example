# Embedding Service Configuration
EMBEDDING_SVC_URL=http://<internal-host>:9092
EMBEDDING_API_KEY=
# Timeout in seconds for embedding-svc calls.
# Large PDFs can produce 200+ chunks; increase if ReadTimeout errors occur.
EMBEDDING_TIMEOUT=120

# Qdrant Vector Database Configuration
QDRANT_URL=http://<internal-host>:6333
QDRANT_API_KEY=
# Qdrant client timeout in seconds; upsert batches are capped at 200 points (#236)
QDRANT_TIMEOUT=30

# Database Configuration
ACADEMIC_DB=/data/academic.db

# Text Processing Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Qdrant Collection Settings
QDRANT_COLLECTION=academic-papers

# API Server Configuration
PORT=8020

# Google API Configuration
GOOGLE_API_KEY=
# Gemini API HTTP timeout in milliseconds
GEMINI_TIMEOUT_MS=60000

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Per-attempt Ollama HTTP timeout in seconds. OllamaClient.generate() retries up to 3x
# (#311), so LLM_GENERATE_TIMEOUT must cover OLLAMA_TIMEOUT*3+backoff, not just a single
# attempt -- raising this value requires raising LLM_GENERATE_TIMEOUT (and
# SUMMARIZE_TOTAL_TIMEOUT) to match.
OLLAMA_TIMEOUT=300

# OpenTelemetry Configuration
OTEL_ENDPOINT=

# Logging Configuration
# Root log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Log format: 'json' or 'text'
LOG_FORMAT=json

# Comma-separated preferred arXiv categories for scoring
PREFERRED_CATEGORIES=cs.AI,cs.LG,cs.CL

# Upload Limit Configuration
MAX_UPLOAD_MB=50

# Write-endpoint auth: X-API-Key required when set, empty disables auth
API_KEY=

# Max seconds for PDF text extraction before the ingest job is failed (#238)
PDF_EXTRACT_TIMEOUT=120

# Ceiling in seconds for RAGSummarizer's llm.generate() call (#237). Must stay >=
# OLLAMA_TIMEOUT*3+backoff(1s+2s) so the outer wait_for never fires before Ollama's
# retries have a chance to run (default: 300*3+3=903 with the defaults above).
LLM_GENERATE_TIMEOUT=903

# Overall ceiling in seconds for RAGSummarizer.summarize() (#269); the embedding, Qdrant
# and LLM wait_for calls inside it are awaited sequentially so their timeouts stack in
# the worst case. Default is EMBEDDING_TIMEOUT + QDRANT_TIMEOUT + LLM_GENERATE_TIMEOUT
# with a small margin for the DB fallback path.
SUMMARIZE_TOTAL_TIMEOUT=1063
